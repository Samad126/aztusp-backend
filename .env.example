# Copy this file to .env and fill it in. Never commit .env.

# Key used to encrypt stored session cookies. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# PostgreSQL connection string (with docker compose the host is `db`)
DATABASE_URL=postgresql://aztusp:aztusp@localhost:5432/aztusp

# Parent domain shared by the login and dashboard subdomains
BASE_DOMAIN=example.com
LOGIN_URL=https://login.example.com/login
DASHBOARD_URL=https://dashboard.example.com/

# Names of the login form inputs (the name="..." attributes on the login page)
USERNAME_FIELD=email
PASSWORD_FIELD=password

REQUEST_TIMEOUT=20

# Password for the compose Postgres container (set a strong one on the server)
POSTGRES_PASSWORD=aztusp

# Origins allowed to call the API from a browser (comma separated)
# CORS_ORIGINS=https://aztu.alakbaroff.com,http://localhost:5173

# Grade watcher (python -m app.watcher). Students turn it on through the API; these settings are shared.
# Minutes between checks of each student's scores
# WATCH_INTERVAL_MINUTES=30

# Mail account that sends result emails, through Brevo's relay. SMTP_USERNAME is your Brevo login email and
# SMTP_PASSWORD an SMTP key from the Brevo "SMTP & API" page (not an API key).
# MAIL_FROM must be a sender verified in Brevo; it defaults to SMTP_USERNAME.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Telegram bot that sends result messages. Create it with @BotFather. Students connect through the API's
# link, so they never send chat ids. TELEGRAM_BOT_USERNAME is the bot's username without @.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
