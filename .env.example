# Copy this file to .env and fill it in. Never commit .env.

# Key used to encrypt stored session cookies. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# PostgreSQL connection string (with docker compose the host is `db`)
DATABASE_URL=postgresql://aztusp:aztusp@localhost:5432/aztusp

# Parent domain shared by the login and dashboard subdomains
BASE_DOMAIN=example.com
LOGIN_URL=https://login.example.com/login
DASHBOARD_URL=https://dashboard.example.com/

# Names of the login form inputs (the name="..." attributes on the login page)
USERNAME_FIELD=email
PASSWORD_FIELD=password

REQUEST_TIMEOUT=20

# Password for the compose Postgres container (set a strong one on the server)
POSTGRES_PASSWORD=aztusp

# Dev only: save the raw HTML of every fetched portal page into this folder (contains personal data; keep it out of git)
# DUMP_PAGES_DIR=samples/raw
